<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Laisse passer les vrais fichiers et dossiers existants (images, JS, CSS, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Toutes les autres routes (ex: /cafards, /rats...) sont redirigées vers index.html
  # pour laisser React gérer l'affichage de la bonne page.
  RewriteRule ^ index.html [L]
</IfModule>
